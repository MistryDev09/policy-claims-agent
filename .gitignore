# Secrets / local credentials — never commit these
.env
*.pem

# OS junk
.DS_Store

# IDE project files
.idea/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Local virtualenv
.venv/

# Large/binary local artifacts not meant for the repo
data/sanlam-insurance-data.zip

# Local scratch scripts/experiments — never committed
scratch/

# logs/ itself IS tracked (transcripts are demo evidence, no secrets in
# them) — only temp files inside it are ignored.
logs/*.tmp

# Built Lambda deployment zips, regenerated by infra/package.py, never
# committed.
build/
